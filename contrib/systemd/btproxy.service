[Unit]
Description=btproxy, ESPHome-compatible Bluetooth proxy
Wants=bluetooth.service network-online.target
After=bluetooth.service network-online.target

[Service]
ExecStart=/usr/local/bin/btproxy -name btproxy-%H -area "" -bluetoothd-restart "systemctl restart bluetooth"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
