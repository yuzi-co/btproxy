# btproxy on OpenWrt. After a change: uci commit btproxy && /etc/init.d/btproxy reload
#
# An option set here locks that field on the settings page. Leave it empty to manage the field on the page.
# Anything not listed goes in the settings file, flat JSON of flag values, such as {"connections": "3"}.

config btproxy 'main'
	# Empty is auto: the kernel backend, or bluez (deprecated) while bluetoothd runs. Or set kernel or bluez.
	option backend ''
	# Node name in Home Assistant. Empty: btproxy-<hostname>.
	option name ''
	option friendly_name ''
	option area ''
	# Settings page address, such as :8080. Empty turns it off. It needs a password (any user name):
	#   (umask 077; echo 'a long password' > /etc/btproxy.uipass)
	option ui ''
	option ui_password_file '/etc/btproxy.uipass'
	# The API is encrypted when this file exists. It holds base64 of 32 bytes, like ESPHome's api: encryption: key:
	#   (umask 077; head -c 32 /dev/urandom | base64 > /etc/btproxy.key)
	# Generate the key elsewhere if busybox has no base64.
	option encryption_key_file '/etc/btproxy.key'
	option config '/etc/btproxy.json'
	# bluez backend only. Runs when bluetoothd hangs, and for the restart button in Home Assistant. Empty turns both off.
	option bluetoothd_restart '/etc/init.d/bluetoothd restart'
	# More flags, for anything that has no option here: see btproxy -h.
	option extra_args ''
