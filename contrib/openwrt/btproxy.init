#!/bin/sh /etc/rc.common
# btproxy: ESPHome-compatible Bluetooth proxy. Home Assistant connects to port 6053.
# Settings are in /etc/config/btproxy.

START=99
USE_PROCD=1

start_service() {
	local name friendly_name area ui ui_password_file encryption_key_file config bluetoothd_restart extra_args
	config_load btproxy
	config_get name main name ''
	config_get friendly_name main friendly_name ''
	config_get area main area ''
	config_get ui main ui ''
	config_get ui_password_file main ui_password_file /etc/btproxy.uipass
	config_get encryption_key_file main encryption_key_file /etc/btproxy.key
	config_get config main config /etc/btproxy.json
	config_get bluetoothd_restart main bluetoothd_restart # no default: empty turns it off
	config_get extra_args main extra_args ''

	procd_open_instance
	procd_set_param command /usr/bin/btproxy -config "$config"
	[ -n "$name" ] && procd_append_param command -name "$name"
	[ -n "$friendly_name" ] && procd_append_param command -friendly-name "$friendly_name"
	[ -n "$area" ] && procd_append_param command -area "$area"
	[ -n "$bluetoothd_restart" ] && procd_append_param command -bluetoothd-restart "$bluetoothd_restart"
	[ -n "$ui" ] && procd_append_param command -ui "$ui"
	[ -n "$ui" ] && [ -f "$ui_password_file" ] && procd_append_param command -ui-password-file "$ui_password_file"
	[ -f "$encryption_key_file" ] && procd_append_param command -encryption-key-file "$encryption_key_file"
	# shellcheck disable=SC2086 # one option holds several flags
	[ -n "$extra_args" ] && procd_append_param command $extra_args
	procd_set_param respawn 3600 10 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger btproxy
}
